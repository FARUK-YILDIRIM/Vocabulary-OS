<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iOS Share extension, signed and unsigned: the App Group only. It is the keychain access group for
     API keys and holds the settings mirror and the inbox. No iCloud: only the app syncs (ADR-002). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(VOS_APP_GROUP)</string>
	</array>
</dict>
</plist>
