<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys Xcode can't generate; merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
	<!-- The App Group the app and the Share extension share (keychain access group, inbox). -->
	<key>VOSAppGroupIdentifier</key>
	<string>$(VOS_APP_GROUP)</string>
	<!-- macOS Services menu: "Capture in Vocabulary-OS" for selected text (SPEC C5). iOS ignores it.
	     NSRequiredContext must be present, or the service is registered but not shown in the menu. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Capture in Vocabulary-OS</string>
			</dict>
			<key>NSMessage</key>
			<string>captureText</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
	<!-- vocabularyos://plan/<id> starts a study plan; reminders open these links (SPEC C10). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vocabularyos</string>
			</array>
		</dict>
	</array>
	<!-- Word lists shared as .vocabularyos files open in the app, which imports them (SPEC C11). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.vocabularyos.wordlist</string>
			<key>UTTypeDescription</key>
			<string>Vocabulary-OS Word List</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vocabularyos</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.vocabularyos.wordlist+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Vocabulary-OS Word List</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.vocabularyos.wordlist</string>
			</array>
		</dict>
	</array>
	<!-- Opened files are read where they are and imported; the app never changes them. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Podcasts keep speaking when the screen locks or another app comes forward (ADR-008), and
	     CloudKit's silent pushes bring changes from other devices while the app is in the background
	     (ADR-002). macOS ignores both. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance: the app uses only the encryption the system provides (HTTPS, the Keychain),
	     which is exempt, so App Store Connect doesn't ask about it for every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Plain HTTP only to local-network AI servers such as Ollama or LM Studio (ADR-003). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
