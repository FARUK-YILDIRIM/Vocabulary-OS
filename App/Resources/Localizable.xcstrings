    "Take Photo" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf Çek"
          }
        }
      }
    },
    "Tap to make a new episode with your words." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelimelerinle yeni bir bölüm yapmak için dokun."
          }
        }
      }
    },
    "Tap to review the words due today." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün tekrar zamanı gelen kelimeler için dokun."
          }
        }
      }
    },
    "Tap to start: ^[%lld question](inflect: true) on your words." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamak için dokun: kelimelerinden %lld soru."
          }
        }
